{
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=$1"
    },
    {
      "source": "/((?!api/|sitemap\\.xml|robots\\.txt|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
